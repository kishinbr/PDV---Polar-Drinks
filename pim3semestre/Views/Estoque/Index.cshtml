@{
    ViewData["Title"] = "Polar Drinks Estoque";
}

@model IEnumerable<ProdutoModel>

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Estoque</h1>
        <a class="btn btn-success mx-2" asp-controller="Estoque" asp-action="Cadastrar">
            <i class="bi bi-file-earmark-plus-fill mx-2"></i>Cadastrar novo Produto
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }

    <table id="Produtos" class="table table-light table-hover mb-auto">
        <thead>
            <tr>
                <th style="width: 20%;">Nome</th>
                <th style="width: 20%;">Descrição</th>
                <th style="width: 15%;">Categoria</th>
                <th style="width: 10%;" class="text-end">Preço</th>
                <th style="width: 10%;" class="text-end">Qtd</th>
                <th style="width: 10%;" class="text-center">Status</th>
                <th style="width: 15%;" class="text-center">Ações</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null)
            {
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>@produto.ProdutoNome</td>

                        <td>@produto.ProdutoDescricao</td>

                        <td>
                            <span class="badge bg-secondary">
                                @produto.Categoria?.CategoriaNome
                            </span>
                        </td>

                        <td class="text-end">
                            @produto.ProdutoPrecoVenda.GetValueOrDefault(0).ToString("C")
                        </td>

                        <td class="text-end">
                            @produto.ProdutoQtdEstoque
                        </td>

                        <!-- STATUS -->
                        <td class="text-center">
                            @if (produto.ProdutoAtivo)
                            {
                                <span class="badge bg-success">Disponível</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Indisponível</span>
                            }
                        </td>

                        <td class="text-center">
                            <a class="btn btn-warning btn-sm mx-1"
                                   asp-controller="Estoque"
                                   asp-action="Editar"
                                   asp-route-id="@produto.ProdutoID">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a class="btn btn-danger btn-sm mx-1"
                                   asp-controller="Estoque"
                                   asp-action="Excluir"
                                   asp-route-id="@produto.ProdutoID">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

