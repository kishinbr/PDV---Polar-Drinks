@{
    ViewData["Title"] = "Estoque";
}

@model IEnumerable<ProdutoModel>

<div class="container p-4 rounded-4">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Estoque</h1>
        <a class="btn btn-success mx-2" asp-controller="Estoque" asp-action="Cadastrar">
            <i class="bi bi-file-earmark-plus-fill mx-2"></i>Cadastrar novo Produto
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }
    else if(TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger text-light" role="alert">
            @TempData["MensagemErro"]
        </div>
    }

    <table id="Produtos" class="table table-light table-hover mb-auto">
        <thead>
            <tr>
                <th style="width: 20%;">Nome</th>
                <th style="width: 25%;">Descrição</th>
                <th style="width: 10%;" class="text-end">Preço Compra</th>
                <th style="width: 10%;" class="text-end">Preço Venda</th>
                <th style="width: 5%;" class="text-end">Qtd</th>
                <th style="width: 5%;" class="text-center">Promoção</th>
                <th style="width: 5%;" class="text-center">Status</th>
                <th style="width: 10%;" class="text-center">Edição</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null)
            {
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>@produto.ProdutoNome</td>

                        <td>@produto.ProdutoDescricao</td>

                        <td class="text-end">
                            @produto.ProdutoPrecoCusto.GetValueOrDefault(0).ToString("C")
                        </td>

                        <td class="text-end">
                            @produto.ProdutoPrecoVenda.GetValueOrDefault(0).ToString("C")
                        </td>

                        <td class="text-end">
                            @if (produto.ProdutoQtdEstoque.GetValueOrDefault(0) <= produto.ProdutoEstoqueMinimo)
                            {
                                <span class="badge bg-warning text-dark">
                                    @($"{produto.ProdutoQtdEstoque.GetValueOrDefault(0)}/{produto.ProdutoEstoqueMinimo}")
                                </span>
                            }
                            else
                            {
                                @($"{produto.ProdutoQtdEstoque.GetValueOrDefault(0)}/{produto.ProdutoEstoqueMinimo}")
                            }
                        </td>

                        <!-- PROMOÇÃO -->
                        <td class="text-center">
                            @if (produto.ProdutoPromocao > 0)
                            {
                                <span class="text-success">@produto.ProdutoPromocao.ToString("0.#")%</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <!-- STATUS -->
                        <td class="text-center">
                            @if (produto.ProdutoAtivo)
                            {
                                <span class="badge bg-success">Disponível</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Indisponível</span>
                            }
                        </td>

                        <td class="text-center">
                            <a class="btn btn-warning btn-sm mx-1"
                                   asp-controller="Estoque"
                                   asp-action="Editar"
                                   asp-route-id="@produto.ProdutoID">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a class="btn btn-info btn-sm mx-1 btn-edicao-rapida"
                                   data-bs-toggle="modal"
                                   data-bs-target="#edicaoRapidaModal"
                                   data-id="@produto.ProdutoID"
                                   data-preco="@produto.ProdutoPrecoVenda"
                                   data-promocao="@produto.ProdutoPromocao">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

<!-- Modal de Edição Rápida -->
<div class="modal fade" id="edicaoRapidaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h5 class="modal-title">Edição Rápida do Produto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEdicaoRapida" method="post" asp-controller="Estoque" asp-action="EdicaoRapida">
                    <input type="hidden" id="ProdutoID" name="ProdutoID" />

                    <div class="mb-3">
                        <label class="form-label">Preço de Venda</label>
                        <input type="text" class="form-control" id="PrecoVenda" name="ProdutoPrecoVenda">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Promoção (%)</label>
                        <input type="text" class="form-control" id="Promocao" name="ProdutoPromocao">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-success" id="btnConfirmarEdicao">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modal = document.getElementById('edicaoRapidaModal');
            var btnConfirmar = document.getElementById('btnConfirmarEdicao');

            modal.addEventListener('show.bs.modal', function(event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var preco = button.getAttribute('data-preco');
                var promocao = button.getAttribute('data-promocao');

                modal.querySelector('#ProdutoID').value = id;
                modal.querySelector('#PrecoVenda').value = preco;
                modal.querySelector('#Promocao').value = promocao;
            });

            btnConfirmar.addEventListener('click', function() {
                document.getElementById('formEdicaoRapida').submit();
            });

            function bloquearPonto(id) {
                var input = document.getElementById(id);

                if (!input) return;

                input.addEventListener("keydown", function(e) {
                    if (e.key === ".") {
                        e.preventDefault();
                    }
                });

                input.addEventListener("input", function() {
                    this.value = this.value.replace(/\./g, "");
                });
            }

            bloquearPonto("PrecoVenda");
            bloquearPonto("Promocao");

        });


    </script>
}