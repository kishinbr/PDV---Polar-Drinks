@model ProdutoModel
@{
    ViewData["title"] = "Cadastrar Produto";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">Cadastrar Produto</h1>
    </div>

    <form method="post" asp-controller="Estoque" asp-action="Cadastrar">

        <!-- NOME -->
        <div class="mb-4">
            <label class="form-label text-light">Nome</label>
            <input type="text" class="form-control bg-white text-dark" asp-for="ProdutoNome" placeholder="Nome do Produto">
            <span asp-validation-for="ProdutoNome" class="text-danger"></span>
        </div>

        <!-- DESCRIÇÃO -->
        <div class="mb-4">
            <label class="form-label text-light">Descrição</label>
            <textarea class="form-control bg-white text-dark" asp-for="ProdutoDescricao" rows="3" placeholder="Descrição do Produto"></textarea>
            <span asp-validation-for="ProdutoDescricao" class="text-danger"></span>
        </div>

        <!-- LINHA: CODIGO + PREÇO CUSTO + PREÇO VENDA -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-light">Código de Barras</label>
                <input type="text" class="form-control bg-white text-dark" asp-for="ProdutoCodBarra" placeholder="Ex: 789123456">
                <span asp-validation-for="ProdutoCodBarra" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Custo</label>
                <input type="number" step="0.01" class="form-control bg-white text-dark" asp-for="ProdutoPrecoCusto" placeholder="0,00">
                <span asp-validation-for="ProdutoPrecoCusto" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Venda</label>
                <input type="number" step="0.01" class="form-control bg-white text-dark" asp-for="ProdutoPrecoVenda" placeholder="0,00">
                <span asp-validation-for="ProdutoPrecoVenda" class="text-danger"></span>
            </div>
        </div>

        <!-- LINHA: QUANTIDADE + ESTOQUE MINIMO + PROMOÇÃO -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-light">Quantidade em Estoque</label>
                <input type="number" class="form-control bg-white text-dark" asp-for="ProdutoQtdEstoque" placeholder="0">
                <span asp-validation-for="ProdutoQtdEstoque" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Estoque Mínimo</label>
                <input type="number" class="form-control bg-white text-dark" asp-for="ProdutoEstoqueMinimo" placeholder="0">
                <span asp-validation-for="ProdutoEstoqueMinimo" class="text-danger"></span>
            </div>

            @* <div class="col-md-4">
                <label class="form-label text-light">Promoção (%)</label>
                <input type="number" step="0.01" class="form-control bg-white text-dark" asp-for="ProdutoPromocao" placeholder="0">
                <span asp-validation-for="ProdutoPromocao" class="text-danger"></span>
            </div> *@
        </div>

        <!-- LINHA: CATEGORIA + ATIVO -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label text-light">Categoria</label>
                <select class="form-select bg-white text-dark" asp-for="CategoriaID" asp-items="ViewBag.Categorias">
                    <option value="">Selecione uma categoria</option>
                </select>
                <span asp-validation-for="CategoriaID" class="text-danger"></span>
            </div>

            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="ProdutoAtivo">
                    <label class="form-check-label text-light">
                        Produto disponível
                    </label>
                </div>
            </div>
        </div>

        <!-- BOTÕES -->
        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-success w-50">Cadastrar</button>
            <a class="btn btn-primary w-50" asp-controller="Estoque" asp-action="Index">Voltar</a>
        </div>

    </form>
</div>