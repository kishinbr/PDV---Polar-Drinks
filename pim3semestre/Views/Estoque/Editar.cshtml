@model ProdutoModel
@{
    ViewData["title"] = "Editar Produto";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">Editar Produto</h1>
    </div>
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-light">
            @TempData["MensagemSucesso"]
        </div>
    }

    <form method="post" asp-action="Editar">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProdutoID" />

        <!-- NOME -->
        <div class="mb-4">
            <label class="form-label text-light">Nome</label>
            <input type="text" class="form-control bg-white text-dark" asp-for="ProdutoNome">
            <span asp-validation-for="ProdutoNome" class="text-danger"></span>
        </div>

        <!-- DESCRIÇÃO -->
        <div class="mb-4">
            <label class="form-label text-light">Descrição</label>
            <textarea class="form-control bg-white text-dark" asp-for="ProdutoDescricao" rows="3"></textarea>
            <span asp-validation-for="ProdutoDescricao" class="text-danger"></span>
        </div>

        <!-- LINHA: CODIGO + PREÇO CUSTO + PREÇO VENDA -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-light">Código de Barras</label>
                <input type="text" class="form-control bg-white text-dark" asp-for="ProdutoCodBarra">
                <span asp-validation-for="ProdutoCodBarra" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Custo</label>
                <input type="number" step="0.01" class="form-control bg-white text-dark" asp-for="ProdutoPrecoCusto">
                <span asp-validation-for="ProdutoPrecoCusto" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Venda</label>
                <input type="number" step="0.01" class="form-control bg-white text-dark" asp-for="ProdutoPrecoVenda">
                <span asp-validation-for="ProdutoPrecoVenda" class="text-danger"></span>
            </div>
        </div>

        <!-- LINHA: QUANTIDADE + ESTOQUE MINIMO -->
        <div class="row mb-4">
            
            <!-- 🔒 QUANTIDADE BLOQUEADA + BOTÃO -->
            <div class="col-md-6">
                <label class="form-label text-light">Quantidade em Estoque</label>

                <div class="d-flex gap-2">
                    <input type="number" class="form-control bg-white text-dark"
                           value="@Model.ProdutoQtdEstoque" readonly>

                    <button type="button" class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#ajusteEstoqueModal">
                        Ajustar
                    </button>
                </div>
            </div>

            <!-- ESTOQUE MINIMO -->
            <div class="col-md-6">
                <label class="form-label text-light">Estoque Mínimo</label>
                <input type="number" class="form-control bg-white text-dark" asp-for="ProdutoEstoqueMinimo">
                <span asp-validation-for="ProdutoEstoqueMinimo" class="text-danger"></span>
            </div>
        </div>

        <!-- ATIVO -->
        <div class="mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="ProdutoAtivo">
                <label class="form-check-label text-light">
                    Produto disponível
                </label>
            </div>
        </div>

        <!-- BOTÕES -->
        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-warning w-50">Salvar Alterações</button>
            <a class="btn btn-primary w-50" asp-action="Index">Voltar</a>
        </div>

    </form>
</div>

<div class="modal fade" id="ajusteEstoqueModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">

            <div class="modal-header">
                <h5 class="modal-title">Ajustar Estoque</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-action="AjustarEstoque">
                <div class="modal-body">

                    <input type="hidden" name="ProdutoID" value="@Model.ProdutoID" />

                    <div class="mb-3">
                        <label>Quantidade Atual</label>
                        <input type="text" class="form-control"
                               value="@Model.ProdutoQtdEstoque" disabled>
                    </div>

                    <div class="mb-3">
                        <label>Nova Quantidade</label>
                        <input type="number" class="form-control" name="NovaQuantidade" required>
                    </div>

                    <div class="mb-3">
                        <label>Descrição da alteração</label>
                        <textarea class="form-control" name="Descricao" rows="3" required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Confirmar</button>
                </div>
            </form>

        </div>
    </div>
</div>