@model IEnumerable<CategoriaModel>
@{
    ViewData["Title"] = "Polar Drinks Categorias";
}

<div class="w-100">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Categorias</h1>
        <a class="btn btn-success mx-2" asp-controller="Categoria" asp-action="Cadastrar">
            <i class="bi bi-file-earmark-plus-fill mx-2"></i>Cadastrar nova Categoria
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }
    @* @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger text-light" role="alert">
            @TempData["MensagemErro"]
        </div>
    } *@
    <table id="Categoria" class="table table-light table-hover mb-auto">
        <thead>
            <tr>
                <th style="width: 30%;">Nome</th>
                <th style="width: 50%;">Descrição</th>
                <th style="width: 20%;" class="text-center">Edição</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null)
            {
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.CategoriaNome</td>

                        <td>@categoria.CategoriaDescricao</td>

                        <td class="text-center">
                            <a class="btn btn-warning btn-sm mx-1"
                                   asp-controller="Categoria"
                                   asp-action="Editar"
                                   asp-route-id="@categoria.CategoriaID">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            @* <a class="btn btn-danger btn-sm mx-1"
                                   asp-controller="Categoria"
                                   asp-action="Excluir"
                                   asp-route-id="@categoria.CategoriaID">
                                <i class="bi bi-trash3-fill"></i>
                            </a> *@
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

