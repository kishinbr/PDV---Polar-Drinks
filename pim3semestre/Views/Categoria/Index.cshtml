@model IEnumerable<CategoriaModel>

<div class="container">
    
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Categorias</h1>
        <a class="btn btn-success mx-2" asp-controller="Categoria" asp-action="Cadastrar"><i class="bi bi-file-earmark-plus-fill mx-2"></i>Cadastrar nova Categoria</a>
    </div>

    @if(TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }
    @* @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger text-light" role="alert">
            @TempData["MensagemErro"]
        </div>
    } *@
    
    

<table id="Categoria" class="table table-light table-hover mt-5 mb-auto ">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Descrição</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @if(Model != null)
        {
            @foreach (var categoria in Model)
            {
                <tr>
                    <th scope="row">@categoria.CategoriaNome</th>
                    <td>@categoria.CategoriaDescricao</td>
                    <td>
                            <a class="btn btn-warning mx-2" asp-controller="Categoria" asp-action="Editar" asp-route-id="@categoria.CategoriaID "><i class="bi bi-pencil-square mx-2"></i>Editar</a>
                            <a class="btn btn-danger mx-2" asp-controller="Categoria" asp-action="Excluir" asp-route-id="@categoria.CategoriaID"><i class="bi bi-trash3-fill mx-2"></i>Excluir</a>
                    </td>
                </tr>
            }
        }
    
    </tbody>
</table>

</div>