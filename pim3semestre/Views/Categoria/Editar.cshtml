@model CategoriaModel
@{
    ViewData["title"] = "Editar Categoria";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">Edição de Categoria</h1>
    </div>

    <form method="post" asp-controller="Categoria" asp-action="Editar">
        <input type="hidden" asp-for="CategoriaID" />

        <div class="mb-3">
            <label for="Nome" class="form-label text-light">Nome:</label>
            <input type="text" class="form-control text-dark bg-white" asp-for="CategoriaNome" id="Nome" placeholder="Nome da Categoria">
            <span asp-validation-for="CategoriaNome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Descricao" class="form-label text-light">Descrição da Categoria:</label>
            <textarea class="form-control text-dark bg-white" asp-for="CategoriaDescricao" id="Descricao" rows="3" placeholder="Descrição da Categoria"></textarea>
            <span asp-validation-for="CategoriaDescricao" class="text-danger"></span>
        </div>

        <div class="mb-3 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="CategoriaAtiva" id="CategoriaAtivo">
                <label class="form-check-label text-light" for="CategoriaAtivo">
                    Categoria Disponível
                </label>
            </div>
        </div>

        <div class="d-flex gap-5 mt-5">
            <button type="submit" class="btn btn-success w-50">Salvar Alterações</button>
            <a class="btn btn-primary w-50" asp-controller="Categoria" asp-action="Index">Voltar</a>
        </div>
    </form>
</div>