@model CategoriaModel
@{
    ViewData["title"] = "Excluir Categoria";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">Exclusão de Categoria</h1>
    </div>

    <form method="post" asp-controller="Categoria" asp-action="Excluir">
        <input type="hidden" asp-for="CategoriaID" />

        <h2 class="text-light mb-4">Tem certeza que deseja excluir esta categoria?</h2>

        <div class="mb-3">
            <label for="Nome" class="form-label text-light">Nome:</label>
            <input type="text" class="form-control text-light" asp-for="CategoriaNome" id="Nome" placeholder="Nome da Categoria" disabled>
                <span asp-validation-for="CategoriaNome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="Descricao" class="form-label text-light">Descrição da Categoria:</label>
                <textarea class="form-control text-light" asp-for="CategoriaDescricao" id="Descricao" rows="3" placeholder="Descrição da Categoria" disabled></textarea>
                <span asp-validation-for="CategoriaDescricao" class="text-danger"></span>
            </div>
    
            <div class="d-flex gap-5 mt-5">
                <button type="submit" class="btn btn-success w-50">Excluir</button>
                <a class="btn btn-primary w-50" asp-controller="Categoria" asp-action="Index">Voltar</a>
            </div>
    
        </form>
    </div>
