@model pim3semestre.ViewModels.CompraDetalhesViewModel

@{
    ViewData["Title"] = "Excluir Reabastecimento";
}
 
<div class="container bg-dark p-4 rounded-4 p-5 mt-5">

    <h2 class="text-danger mb-4">
        Excluir Reabastecimento #@Model.Compra.CompraID
    </h2>


    <div class="text-light mb-3">
        <strong>Data:</strong> @Model.Compra.CompraData.ToString("dd/MM/yyyy") <br />
        <strong>Fornecedor:</strong> @Model.Compra.Fornecedor?.FornecedorNome <br />
        <strong>Status:</strong> @Model.Compra.CompraStatus <br />
        <strong>Data de Entrega:</strong> Não Entregue <br />
    </div>


    <table class="table table-light table-hover">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th class="text-end">Unitário</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto?.ProdutoNome</td>
                    <td>@item.ItemCompraQtd</td>
                    <td class="text-end">@item.ItemCompraPreco.ToString("C")</td>
                    <td class="text-end">@((item.ItemCompraQtd * item.ItemCompraPreco).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end text-light mt-3">
        <h4>Total: @Model.Compra.CompraValorTotal.ToString("C")</h4>
    </div>

    <div class="d-flex gap-2 mt-3 justify-content-between">

        <a asp-action="Index" class="btn btn-primary">
            Cancelar
        </a>

        <form asp-action="ConfirmarExclusao" method="post">
            <input type="hidden" name="id" value="@Model.Compra.CompraID" />

            <button type="submit" class="btn btn-danger">
                 Confirmar Exclusão
            </button>
        </form>

    </div>

</div>
