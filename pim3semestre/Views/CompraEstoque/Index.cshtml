@model pim3semestre.ViewModels.CompraIndexViewModel
@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success text-light">
        @TempData["MensagemSucesso"]
    </div>
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Reabastecimento</h2>

        <a asp-action="Cadastrar" class="btn btn-success">
            + Novo Reabastecimento
        </a>
    </div>

    <h4>Pedidos Pendentes</h4>
    @if (Model.Pendentes != null && Model.Pendentes.Any())
{
    <table class="table table-warning table-hover mb-5">
        <thead>
            <tr>
                <th>ID</th>
                <th>Data</th>
                <th>Fornecedor</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Pendentes)
            {
                <tr>
                    <td>@item.CompraID</td>
                    <td>@item.CompraData.ToString("dd/MM/yyyy")</td>
                    <td>@item.Fornecedor?.FornecedorNome</td>
                    <td>@item.CompraStatus</td>
                    <td class="text-center">
                            
                            <a asp-action="Detalhes"
                                   asp-route-id="@item.CompraID"
                                   asp-route-confirmar="false"
                                   class="btn btn-primary btn-sm">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </a>

                           
                            <a asp-action="Detalhes"
                                   asp-route-id="@item.CompraID"
                                   asp-route-confirmar="true"
                                   class="btn btn-success btn-sm">
                                <i class="bi bi-truck"></i>
                            </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
        <div class="text-center text-muted my-4">
            <i class="bi bi-inbox fs-3"></i>
            <p class="mt-2">Nenhum pedido pendente</p>
        </div>
    }

    
    <h4>Pedidos Concluídos</h4>

    @* <div class="row mb-3">
        <div class="col-md-3">
            <label>Data Inicial</label>
            <input type="date" id="dataInicio" class="form-control">
        </div>
        <div class="col-md-3">
            <label>Data Final</label>
            <input type="date" id="dataFim" class="form-control">
        </div>
    </div> *@

    <table id="tabelaConcluidos" class="table table-success table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Data Compra</th>
                <th>Data Entrega</th>
                <th>Fornecedor</th>
                <th>Status</th>
                <th class="text-center">Detalhes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Concluidas)
            {
                <tr>
                    <td>@item.CompraID</td>
                    <td>@item.CompraData.ToString("yyyy-MM-dd")</td>
                    <td>@item.CompraDataEntrega?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Fornecedor?.FornecedorNome</td>
                    <td>@item.CompraStatus</td>
                    <td class="text-center">
                        <a class="btn btn-primary btn-sm"
                               asp-action="Detalhes"
                               asp-route-id="@item.CompraID">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>