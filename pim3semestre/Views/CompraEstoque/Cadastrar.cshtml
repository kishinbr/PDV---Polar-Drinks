@model pim3semestre.ViewModels.CompraCreateViewModel

@{
    ViewData["Title"] = "Novo Reabastecimento";
}

<div class="container bg-dark p-5 rounded-5">

    <div class="text-center mb-4">
        <h2 class="text-light">Novo Reabastecimento</h2>
    </div>

    <form method="post">

        <!-- FORNECEDOR -->
        <div class="mb-4">
            <label class="form-label text-light">Fornecedor</label>
            <select class="form-select" asp-for="FornecedorID" asp-items="Model.Fornecedores">
                <option value="">Selecione um fornecedor</option>
            </select>
            <span asp-validation-for="FornecedorID" class="text-danger"></span>
        </div>

        <!-- TABELA DE PRODUTOS -->
        <table class="table table-light" id="tabelaItens">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th style="width:150px;">Quantidade</th>
                    <th style="width:150px;">Preço</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Itens.Count; i++)
                {
                    <tr>
                        <td>
                            <select class="form-select" asp-for="Itens[@i].ProdutoID" asp-items="Model.Produtos">
                                <option value="">Selecione</option>
                            </select>
                        </td>
                        <td>
                            <input class="form-control" asp-for="Itens[@i].Quantidade" />
                        </td>
                        <td>
                            <input class="form-control" asp-for="Itens[@i].Preco" />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-remover">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- BOTÃO ADICIONAR -->
        <button type="button" id="addItem" class="btn btn-primary mb-3">
            + Adicionar Produto
        </button>

        <!-- BOTÃO SALVAR -->
        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success w-50">Salvar</button>
            <a asp-action="Index" class="btn btn-primary w-50">Voltar</a>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        let index = @Model.Itens.Count;

        // Adicionar nova linha
        $("#addItem").click(function () {
            let options = `@Html.Raw(string.Join("", Model.Produtos.Select(p => $"<option value='{p.Value}'>{p.Text}</option>")))`;

            let row = `
            <tr>
                <td>
                    <select name="Itens[${index}].ProdutoID" class="form-select">
                        <option value="">Selecione</option>
                        ${options}
                    </select>
                </td>
                <td><input name="Itens[${index}].Quantidade" class="form-control" /></td>
                <td><input name="Itens[${index}].Preco" class="form-control" /></td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-remover">X</button>
                </td>
            </tr>`;
            $("#tabelaItens tbody").append(row);
            index++;
        });

        // Remover linha
        $(document).on("click", ".btn-remover", function () {
            $(this).closest("tr").remove();
        });
    </script>
}