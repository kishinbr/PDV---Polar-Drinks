@model pim3semestre.ViewModels.CompraCreateViewModel
@{
    ViewData["Title"] = "Novo Reabastecimento";
}

<div class="container bg-dark p-5 rounded-5">

    <div class="text-center mb-4">
        <h2 class="text-light">Novo Reabastecimento</h2>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert bg-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }
    else if (TempData["MensagemErro"] != null)
    {
        <div class="alert bg-danger text-light" role="alert">
            @TempData["MensagemErro"]
        </div>
    }

    <div id="erroTabela" class="alert bg-danger text-light d-none" role="alert">
        Adicione pelo menos um produto antes de salvar.
    </div>

    <form method="post" id="formCompra">
        <div class="mb-4">
            <label class="form-label text-light">Fornecedor</label>
            <select class="form-select bg-light text-dark" asp-for="FornecedorID" asp-items="Model.Fornecedores">
                <option value="">Selecione um fornecedor</option>
            </select>
            <span asp-validation-for="FornecedorID" class="text-danger"></span>
        </div>

        <table class="table table-light" id="tabelaItens">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th style="width:150px;">Quantidade</th>
                    <th style="width:150px;">Preço</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Itens.Count; i++)
                {
                    <tr>
                        <td>
                            <select class="form-select" asp-for="Itens[@i].ProdutoID" asp-items="Model.Produtos">
                                <option value="">Selecione</option>
                            </select>
                            <span asp-validation-for="Itens[@i].ProdutoID" class="text-danger"></span>
                        </td>
                        <td>
                            <input class="form-control" asp-for="Itens[@i].Quantidade" />
                            <span asp-validation-for="Itens[@i].Quantidade" class="text-danger"></span>
                        </td>
                        <td>
                            <input class="form-control preco-input" asp-for="Itens[@i].Preco" />
                            <span asp-validation-for="Itens[@i].Preco" class="text-danger"></span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-remover">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mb-3">
            <button type="button" id="addItem" class="btn btn-primary">
                + Adicionar Produto
            </button>
            <span class="fw-bold text-light" id="totalPreco">Total: R$ 0,00</span>
        </div>

        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success w-50">Salvar</button>
            <a asp-action="Index" class="btn btn-primary w-50">Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let index = @Model.Itens.Count;

        const options = `@Html.Raw(string.Join("", Model.Produtos.Select(p => $"<option value='{p.Value}'>{p.Text}</option>")))`;

        // ==================== RENUMERAR ÍNDICES ====================
        // garante sequência contínua [0],[1],[2]... antes de submeter
        function renumerarIndices() {
            $("#tabelaItens tbody tr").each(function (i) {
                $(this).find("select").attr("name", `Itens[${i}].ProdutoID`);
                $(this).find("input[name$='.Quantidade']").attr("name", `Itens[${i}].Quantidade`);
                $(this).find("input[name$='.Preco'], input.preco-input").attr("name", `Itens[${i}].Preco`);

                // atualiza os spans de validação também
                $(this).find("span[data-valmsg-for]").each(function() {
                    let field = $(this).attr("data-valmsg-for");
                    let newField = field.replace(/Itens\[\d+\]/, `Itens[${i}]`);
                    $(this).attr("data-valmsg-for", newField);
                });
            });

            // atualiza o index para o próximo item
            index = $("#tabelaItens tbody tr").length;
        }

        // ==================== TOTAL ====================
        function atualizarTotal() {
            let total = 0;
            $("#tabelaItens tbody tr").each(function () {
                let qtd = parseFloat($(this).find('input[name$=".Quantidade"]').val());
                let preco = parseFloat($(this).find('input[name$=".Preco"]').val().replace(',', '.'));
                if (!isNaN(qtd) && !isNaN(preco)) {
                    total += qtd * preco;
                }
            });
            $("#totalPreco").text("Total: R$ " + total.toFixed(2).replace('.', ','));
        }

        // ==================== ADICIONAR LINHA ====================
        $("#addItem").click(function () {
            let newRow = $(`
                <tr>
                    <td>
                        <select name="Itens[${index}].ProdutoID" class="form-select"
                                data-val="true"
                                data-val-required="Selecione um produto">
                            <option value="">Selecione</option>
                            ${options}
                        </select>
                        <span class="text-danger field-validation-valid"
                              data-valmsg-for="Itens[${index}].ProdutoID"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input type="number" name="Itens[${index}].Quantidade" class="form-control"
                               value="0" min="0"
                               data-val="true"
                               data-val-required="Informe a quantidade"
                               data-val-range="Quantidade inválida"
                               data-val-range-min="0"
                               data-val-range-max="2147483647" />
                        <span class="text-danger field-validation-valid"
                              data-valmsg-for="Itens[${index}].Quantidade"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input type="text" name="Itens[${index}].Preco" class="form-control preco-input"
                               value="0,00"
                               data-val="true"
                               data-val-required="Informe o preço"
                               data-val-number="Preço deve ser um número"
                               data-val-range="Preço inválido"
                               data-val-range-min="0.00"
                               data-val-range-max="999999.99" />
                        <span class="text-danger field-validation-valid"
                              data-valmsg-for="Itens[${index}].Preco"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-remover">X</button>
                    </td>
                </tr>
            `);

            $("#tabelaItens tbody").append(newRow);

            // parse DEPOIS do append com o form inteiro
            $.validator.unobtrusive.parse("#formCompra");

            atualizarTotal();
            index++;
        });

        // ==================== REMOVER LINHA ====================
        $(document).on("click", ".btn-remover", function () {
            $(this).closest("tr").remove();
            renumerarIndices();
            atualizarTotal();
        });

        // ==================== INPUT QUANTIDADE ====================
        $(document).on("input", 'input[name$=".Quantidade"]', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
            atualizarTotal();
        });

        // ==================== INPUT PREÇO ====================
        $(document).on("input", 'input.preco-input', function () {
            let value = this.value.replace(/[^0-9,]/g, '');
            let parts = value.split(',');
            if (parts.length > 2) value = parts[0] + ',' + parts[1];
            if (value.includes(',')) {
                let [intPart, decPart] = value.split(',');
                value = intPart + ',' + decPart.substring(0, 2);
            }
            this.value = value;
            atualizarTotal();
        });

        // ==================== SUBMIT ====================
        $("#formCompra").on("submit", function (e) {


            let temItens = $("#tabelaItens tbody tr").length > 0;

            if (!temItens) {
                e.preventDefault();

                // força reaparecer sempre
                $("#erroTabela")
                    .removeClass("d-none")
                    .hide()
                    .fadeIn();

                window.scrollTo(0, 0);
                return false;
            }

            // esconde corretamente quando tiver item
            $("#erroTabela").addClass("d-none");

            renumerarIndices();

            $('input.preco-input').each(function () {
                this.value = this.value.replace(',', '.');
                if (this.value.trim() === '' || isNaN(this.value)) {
                    this.value = '0';
                }
            });

            $('input[name$=".Quantidade"]').each(function () {
                if (this.value.trim() === '' || isNaN(this.value)) {
                    this.value = '0';
                }
            });
        });

        // ==================== INIT ====================
        $(document).ready(function () {
            atualizarTotal();
        });
    </script>
}