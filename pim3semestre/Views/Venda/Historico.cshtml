@model IEnumerable<pim3semestre.Models.VendaFinalModel>
@{
    ViewData["Title"] = "Histórico de Vendas";
}

<div>

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Histórico de Vendas</h1>

        <a asp-action="Cadastrar" class="btn btn-success mx-2">
            <i class="bi bi-cart-plus-fill mx-2"></i>
            Nova Venda
        </a>
    </div>

    <!-- FILTRO -->
    <div class="mb-3 d-flex justify-content-center">
        <form method="get" class="d-flex align-items-end gap-2 flex-wrap">

            <div>
                <label class="form-label small mb-1">Início</label>
                <input type="date" name="dataInicio" class="form-control form-control-sm"
                       value="@ViewBag.DataInicio?.ToString("yyyy-MM-dd")" />
            </div>

            <div>
                <label class="form-label small mb-1">Fim</label>
                <input type="date" name="dataFim" class="form-control form-control-sm"
                       value="@ViewBag.DataFim?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="d-flex gap-1">
                <button type="submit" class="btn btn-success btn-sm px-2">
                    <i class="bi bi-funnel-fill"></i>
                </button>

                <a asp-action="Historico" class="btn btn-outline-secondary btn-sm px-2">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

        </form>
    </div>

    <!-- TABELA -->
    <table id="Vendas" class="table table-light table-hover mb-auto">
        <thead>
            <tr>
                <th style="width: 8%;">ID da Venda</th>
                <th style="width: 18%;">Data</th>
                <th style="width: 18%;">Total</th>
                <th style="width: 16%;">Pagamento</th>
                <th style="width: 10%;">Itens</th>
                <th style="width: 10%;" class="text-center">Ações</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var venda in Model)
                {
                    <tr>
                        <td>@venda.VendaID</td>

                        
                        <td data-order="@venda.VendaData.ToString("yyyy-MM-dd HH:mm")">
                            @venda.VendaData.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>@venda.VendaValorTotal.ToString("C")</td>

                    
                        <td>
                            @if (venda.VendaTipoPagamento == "Pix")
                            {
                                <span class="badge bg-success">Pix</span>
                            }
                            else if (venda.VendaTipoPagamento == "Dinheiro")
                            {
                                <span class="badge bg-warning text-dark">Dinheiro</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Cartão</span>
                            }
                        </td>

                        <td>@venda.Itens.Count</td>

                        <td class="text-center">
                            <a class="btn btn-primary btn-sm"
                                   asp-action="Detalhes"
                                   asp-route-id="@venda.VendaID"
                                   title="Ver detalhes">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        Nenhuma venda registrada
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#Vendas').DataTable({
                pageLength: 10,
                lengthMenu: [10, 20],
                order: [[1, "desc"]],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                },
                columnDefs: [
                    { orderable: false, targets: [4, 5] }, 
                    { className: "text-center", targets: [0, 1, 5] }, 
                    { className: "text-end", targets: [2, 3, 4] } 
                ]
            });
        });
    </script>
}