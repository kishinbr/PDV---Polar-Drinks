@model pim3semestre.Models.VendaFinalModel
@{
    ViewData["Title"] = "Nova Venda";
}

<div class="container bg-dark p-4 rounded-4 d-flex flex-column"
     style="height:100vh; overflow:hidden; padding-top:20px; padding-bottom:20px;">

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    <div id="mensagemErro" class="alert alert-danger @(TempData["MensagemErro"] == null ? "d-none" : "")">
        @TempData["MensagemErro"]
    </div>

    <h2 class="text-light text-center mb-3">Nova Venda</h2>

    <form asp-action="FinalizarVenda" method="post" id="formVenda"
          class="d-flex flex-column flex-grow-1 overflow-hidden">
        @Html.AntiForgeryToken()

        <!-- BUSCA -->
        <div class="mb-3">
            <label class="form-label text-light">Buscar Produto</label>
            <div class="position-relative">
                <input type="text" id="buscaProduto" class="form-control" placeholder="Código ou nome" autocomplete="off">
                <div id="listaSugestoes" class="list-group position-absolute w-100" style="z-index:1000;"></div>
            </div>
        </div>

        <!-- CONTEÚDO PRINCIPAL -->
        <div class="row flex-grow-1 overflow-hidden">

            <!-- ESQUERDA -->
            <div class="col-md-4 d-flex flex-column">

                <div class="mb-2">
                    <label class="form-label text-light">Quantidade</label>
                    <input type="number" id="quantidade" class="form-control" value="0">
                </div>

                <div class="mb-2">
                    <label class="form-label text-light">Valor Unitário</label>
                    <input type="text" id="valorUnitario" class="form-control" readonly>
                </div>

                <div class="mb-2">
                    <label class="form-label text-light">Total</label>
                    <input type="text" id="valorTotal" class="form-control" readonly>
                </div>

                <!-- BOTÃO MAIOR -->
                <button type="button" id="btnAdicionar"
                        class="btn btn-success w-100 mt-2"
                        style="height:60px; font-size:18px;">
                    Adicionar Item
                </button>

                <div class="mb-3 mt-4" style="padding-left:8px;">
                    <label class="form-label text-light" style="font-size:18px; font-weight:600;">
                        Tipo de Pagamento:
                    </label>

                    <div class="d-flex flex-column gap-3" style="font-size:18px;">

                        <div class="form-check">
                            <input class="form-check-input" style="transform:scale(1.2);" type="radio" name="VendaTipoPagamento" id="pagDinheiro" value="Dinheiro">
                            <label class="form-check-label text-light" style="font-size:17px;" for="pagDinheiro">Dinheiro</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" style="transform:scale(1.2);" type="radio" name="VendaTipoPagamento" id="pagPix" value="Pix">
                            <label class="form-check-label text-light" style="font-size:17px;" for="pagPix">Pix</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" style="transform:scale(1.2);" type="radio" name="VendaTipoPagamento" id="pagCartao" value="Cartão">
                            <label class="form-check-label text-light" style="font-size:17px;" for="pagCartao">Cartão</label>
                        </div>

                    </div>
                </div>

                <div class="mt-auto d-flex justify-content-center" style="margin-bottom:10px;">
                    <h2 class="text-light m-0 text-center"
                        style="font-size:34px; font-weight:700;">
                        Total: <span id="totalVenda">R$ 0,00</span>
                    </h2>
                </div>

            </div>

            <div class="col-md-8 d-flex flex-column" style="min-height:0;">

                <!-- TABELA -->
                <div class="flex-grow-1 overflow-auto">
                    <table class="table table-light table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th class="text-end">Qtd</th>
                                <th class="text-end">Unitário</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabelaItens"></tbody>
                    </table>
                </div>

                <div class="mt-3 p-3 rounded-3">
                    <button id="btnConfirmar" type="submit" class="btn btn-success w-100" disabled>
                        Confirmar Venda
                    </button>
                </div>

            </div>
        </div>

        <div id="itensHidden"></div>

    </form>

</div>
@section Scripts {
    <script>
        const produtos = @Html.Raw(Json.Serialize(ViewBag.Produtos));
    </script>

    <script src="~/js/vendas.js"></script>
}