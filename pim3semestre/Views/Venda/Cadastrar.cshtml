@model pim3semestre.Models.VendaFinalModel
@{
    ViewData["Title"] = "Nova Venda";
}

<div class="container bg-dark p-4 rounded-4">

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }
    <div id="mensagemErro" class="alert alert-danger @(TempData["MensagemErro"] == null ? "d-none" : "")">
        @TempData["MensagemErro"]
    </div>

    <h2 class="text-light text-center mb-4">Nova Venda</h2>

    <div id="mensagemErroJs" class="alert alert-danger d-none"></div>

    <form asp-action="FinalizarVenda" method="post" id="formVenda">
        @Html.AntiForgeryToken()

        <!-- ================= LINHA 1 ================= -->
        <div class="row mb-4">

            <!-- BUSCA -->
            <div class="col-md-12">
                <label class="form-label text-light">Buscar Produto (Código ou Nome)</label>
                <div class="position-relative">
                    <input type="text" id="buscaProduto" class="form-control" placeholder="Digite o código ou nome do produto" autocomplete="off">
                    <div id="listaSugestoes" class="list-group position-absolute w-100" style="z-index:1000;"></div>
                </div>
            </div>

        </div>

        <!-- ================= LINHA 2 ================= -->
        <div class="row">

            <!-- ESQUERDA -->
            <div class="col-md-4">

                <div class="mb-3">
                    <label class="form-label text-light">Quantidade</label>
                    <input type="number" id="quantidade" class="form-control" value="1">
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Valor Unitário</label>
                    <input type="text" id="valorUnitario" class="form-control" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Total</label>
                    <input type="text" id="valorTotal" class="form-control" readonly>
                </div>

                <button type="button" id="btnAdicionar" class="btn btn-success w-100 mt-2">
                    Adicionar Item
                </button>

            </div>

            <!-- DIREITA -->
            <div class="col-md-8 d-flex flex-column">

                <div class="flex-grow-1">
                    <table class="table table-light table-hover">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th class="text-end">Qtd</th>
                                <th class="text-end">Unitário</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>

                        <tbody id="tabelaItens"></tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 p-3 rounded-3">
                    <h4 class="text-light m-0">
                        Total: <span id="totalVenda">R$ 0,00</span>
                    </h4>

                    <div class="mb-3 mt-2">
                        <label class="form-label text-light">Tipo de Pagamento:</label>
                        <div class="d-flex gap-3">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagDinheiro" value="Dinheiro" required>
                                <label class="form-check-label text-light" for="pagDinheiro">Dinheiro</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagPix" value="Pix" required>
                                <label class="form-check-label text-light" for="pagPix">Pix</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagCartao" value="Cartão" required>
                                <label class="form-check-label text-light" for="pagCartao">Cartão</label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Confirmar Venda
                    </button>
                </div>

            </div>

        </div>

        <!-- INPUTS HIDDEN PARA ITENS -->
        <div id="itensHidden"></div>

    </form>

</div>

@section Scripts {
    <script>
        const produtos = @Html.Raw(Json.Serialize(ViewBag.Produtos));
    </script>

    <script src="~/js/vendas.js"></script>
}