
@model pim3semestre.Models.VendaFinalModel
@{
    ViewData["Title"] = "Histórico de Vendas";
}


<div class="container bg-dark p-4 rounded-4">

    <h2 class="text-light mb-4">Detalhes da Venda #@Model.VendaID</h2>

    <div class="text-light mb-3">
        <strong>Data:</strong> @Model.VendaData.ToString("dd/MM/yyyy HH:mm") <br />
        <strong>Pagamento:</strong> @Model.VendaTipoPagamento <br />
        <strong>Total:</strong> @Model.VendaValorTotal.ToString("C")
    </div>
    


    <table class="table table-light">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th>Unitário</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto?.ProdutoNome</td>
                    <td>@item.ItemVendaQtd</td>
                    <td>@item.ItemVendaPreco.ToString("C")</td>
                    <td>@item.ItemVendaTotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Historico" class="btn btn-primary">Voltar</a>

</div>