<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="icon" href="~/img/icon.png" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/layout.css" />
</head>
<body>
    <div class="topbar">
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral">
            <i class="bi bi-list"></i>
        </button>
        <div> <img src="/img/polaria.png" width="32" height="32">Polar Drinks</div>
    </div>

    <!-- SIDEBAR DESKTOP -->
    <div class="sidebar">
        <div class="brand"><img src="/img/polaria.png" width="32" height="32"> Polar Drinks</div>

        <!-- GESTÃO -->
        <div class="menu-section">GESTÃO</div>

        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-fill"></i> Home
        </a>

        <a asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-graph-up"></i> Dashboard
        </a>

        <!-- ESTOQUE -->
        <div class="menu-section">ESTOQUE</div>

        <a asp-controller="Estoque" asp-action="Index">
            <i class="bi bi-box-seam"></i> Estoque
        </a>

        <a asp-controller="Estoque" asp-action="Movimentacoes">
            <i class="bi bi-arrow-left-right"></i> Movimentações
        </a>

        

        <!-- VENDAS -->
        <div class="menu-section">VENDAS</div>

        <a asp-controller="Venda" asp-action="Cadastrar">
            <i class="bi bi-cart-check"></i> Vendas
        </a>

        <a asp-controller="Venda" asp-action="Index">
            <i class="bi bi-receipt"></i> Histórico Vendas
        </a>

        <!-- FORNECEDORES -->
        <div class="menu-section">FORNECEDORES</div>

        <a asp-controller="Fornecedor" asp-action="Index">
            <i class="bi bi-truck"></i> Fornecedor
        </a>
        <a asp-controller="CompraEstoque" asp-action="Index">
            <i class="bi bi-bag-plus"></i> Reabastecer
        </a>
    </div>

   
    <div class="offcanvas offcanvas-start text-light"
     tabindex="-1"
     id="menuLateral"
     style="background:#181818;">

    <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title"><img src="/img/polaria.png" width="32" height="32"> Polar Drinks</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body p-3">

        <!-- GESTÃO -->
        <div class="menu-section">GESTÃO</div>

        <a class="menu-item" href="/Home/Index">
            <i class="bi bi-house-fill"></i> Home
        </a>

        <a class="menu-item" href="/Dashboard/Index">
            <i class="bi bi-graph-up"></i> Dashboard
        </a>

        <!-- ESTOQUE -->
        <div class="menu-section">ESTOQUE</div>

        <a class="menu-item" href="/Estoque/Index">
            <i class="bi bi-box-seam"></i> Estoque
        </a>

        <a class="menu-item" href="/Estoque/Movimentacoes">
            <i class="bi bi-arrow-left-right"></i> Movimentações
        </a>

        

        <!-- VENDAS -->
        <div class="menu-section">VENDAS</div>

        <a class="menu-item" href="/Venda/Cadastrar">
            <i class="bi bi-cart-check"></i> Vendas
        </a>

        <a class="menu-item" href="/Venda/Index">
            <i class="bi bi-receipt"></i> Histórico
        </a>

        <!-- FORNECEDORES -->
        <div class="menu-section">FORNECEDORES</div>

        <a class="menu-item" href="/Fornecedor/Index">
            <i class="bi bi-truck"></i> Fornecedor
        </a>
        <a class="menu-item" href="/CompraEstoque/Index">
            <i class="bi bi-bag-plus"></i> Reabastecer
        </a>

    </div>
</div>

    <!-- CONTEÚDO -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>