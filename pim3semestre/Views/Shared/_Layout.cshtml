<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Polar Drinks</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Materia.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/pim3semestre.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.css" rel="stylesheet">

    <link rel="icon" type="image/png" sizes="64x64" href="~/img/icon.png">

        <style>
                html, body {
                    height: 100%;
                    margin: 0;
                }

                body {
                    display: flex;
                    flex-direction: column;
                    min-height: 100vh;
                }

                header {
                    position: sticky;
                    top: 0;
                    z-index: 1000;
                }

                main {
                    flex: 1;
                }

                footer {
                    margin-top: auto;
                }
        </style>
        
    </head>

    <body>

        <!-- HEADER FIXO -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand text-light" asp-area="" asp-controller="Home" asp-action="Index">
                        Polar Drinks
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-fill mx-2"></i>Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Estoque">
                                    <i class="bi bi-diagram-3-fill mx-2"></i>Estoque
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Categoria" asp-action="Index">
                                    <i class="bi bi-cup-straw mx-2"></i>Categoria
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- CONTEÚDO -->
        <div class="container">
            <main role="main" class="container pb-3">
                @RenderBody()
            </main>
        </div>
        

        <!-- FOOTER FIXO -->
        <footer class="border-top text-muted bg-dark">
            <div class="container text-light py-2">
                &copy; 2026 - Polar Drinks -
                <a class="text-light" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

        <!-- SCRIPTS -->
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.js"></script>

        @await RenderSectionAsync("Scripts", required: false)

    </body>
</html>