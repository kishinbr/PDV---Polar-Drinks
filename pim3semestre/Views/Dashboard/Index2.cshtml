@{
    ViewData["Title"] = "Dashboard";
}
@model pim3semestre.Models.DashboardViewModel
@using System.Globalization
@*  *@

<div style="background:#212529; min-height:100vh;">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h6 class="m-0 fw-normal text-secondary pt-2 mt-2">
                Gestão / <span class="text-light">Dashboard</span>
            </h6>
            <span class="badge rounded-pill text-bg-secondary fw-normal" style="font-size:.7rem;" id="dashDate"></span>
        </div>

        <div class="row g-3 mb-4 ">

            <!-- COLUNA ESQUERDA -->
            <div class="col-md-8 d-flex flex-column gap-3">

                <!-- FINANCEIRO (2x2) -->
                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                            <div class="mb-2 bg-primary" style="height:2px;"></div>
                            <div class="text-light mb-1">Total Hoje</div>
                            <div class="fw-semibold text-primary" style="font-size:1.35rem;">R$ @Model.TotalHoje.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                            <div class="mb-2" style="height:2px; background:#a78bfa;"></div>
                            <div class="text-light mb-1">Total Mês</div>
                            <div class="fw-semibold " style="font-size:1.35rem; color:#a78bfa">R$ @Model.TotalMes.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                            <div class="mb-2 bg-success" style="height:2px;"></div>
                            <div class="text-light mb-1">Lucro Hoje</div>
                            <div class="fw-semibold text-success" style="font-size:1.35rem;">R$ @Model.LucroHoje.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                            <div class="mb-2 bg-warning" style="height:2px;"></div>
                            <div class="text-light mb-1">Lucro Mês</div>
                            <div class="fw-semibold text-warning" style="font-size:1.35rem;">R$ @Model.LucroMes.ToString("N2")</div>
                        </div>
                    </div>

                
                </div>

                <!-- GRÁFICO VENDAS -->
                <div class="card shadow border rounded-4 p-3 flex-fil text-light" style="background:#13161d;">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h6 class="mb-0">Vendas</h6>

                        <span class="badge bg-light text-dark border" id="totalVendasLabel">
                            Qtd vendas: 0
                        </span>

                        <div class="btn-group btn-group-sm flex-wrap">
                            <button class="btn btn-outline-primary" onclick="atualizarVendas('hoje')">Hoje</button>
                            <button class="btn btn-outline-primary" onclick="atualizarVendas('semana')">7d</button>
                            <button class="btn btn-outline-primary" onclick="atualizarVendas('mes')">30d</button>
                            <button class="btn btn-outline-primary" onclick="atualizarVendas('ano')">Ano</button>
                        </div>
                    </div>

                    <canvas id="graficoVendas" style="height:300px;"></canvas>

                </div>

            </div>

            <!-- COLUNA DIREITA -->
            <div class="col-md-4 d-flex flex-column gap-3">

                <!-- PAGAMENTOS (CARDS) -->
                <div class="row g-3">

                    <!-- PIX -->
                    <div class="col-12 col-xl-4">
                        <div class="card border p-3 shadow rounded-4 h-100"
                             style="background:#13161d; border:1px solid rgba(255,255,255,0.07);">

                            <small class="text-light d-flex align-items-center gap-1">
                                <img src="/img/pix.png" width="16">
                                Pix
                            </small>

                            <div class="text-light">@Model.QtdPix vendas</div>

                            <h5 style="color:#34d399;">
                                @("R" + Model.TotalPix.ToString("C"))
                            </h5>

                        </div>
                    </div>

                    <!-- CARTÃO -->
                    <div class="col-12 col-xl-4">
                        <div class="card border p-3 shadow rounded-4 h-100"
                             style="background:#13161d; border:1px solid rgba(255,255,255,0.07);">

                            <small class="text-light">💳 Cartão</small>

                            <div class="text-light">@Model.QtdCartao vendas</div>

                            <h5 style="color:#4f8ef7;">
                                @("R" + Model.PrevisaoAmanha.ToString("C"))
                            </h5>

                        </div>
                    </div>

                    <!-- DINHEIRO -->
                    <div class="col-12 col-xl-4">
                        <div class="card border p-3 shadow rounded-4 h-100"
                             style="background:#13161d; border:1px solid rgba(255,255,255,0.07);">

                            <small class="text-light">💵 Dinheiro</small>

                            <div class="text-light">@Model.QtdDinheiro vendas</div>

                            <h5 style="color:#f59e0b;">
                                @("R" + Model.TotalDinheiro.ToString("C"))
                            </h5>

                        </div>
                    </div>

                </div>

                <!-- GRÁFICO PAGAMENTOS -->
                <div class="card border rounded-4 p-3 flex-fill"
                     style="background:#13161d; border:1px solid rgba(255,255,255,0.07);">

                    <!-- HEADER -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">

                        <h6 class="mb-0 text-light">Formas de Pagamento</h6>

                        <span class="badge bg-success" id="qtdPagamentosLabel">
                            Qtd vendas: 0
                        </span>

                        <div class="btn-group btn-group-sm flex-wrap">
                            <button class="btn btn-outline-success"
                                    onclick="atualizarPagamentos('hoje')">
                                Hoje
                            </button>
                            <button class="btn btn-outline-success"
                                    onclick="atualizarPagamentos('semana')">
                                7d
                            </button>
                            <button class="btn btn-outline-success"
                                    onclick="atualizarPagamentos('mes')">
                                30d
                            </button>
                            <button class="btn btn-outline-success"
                                    onclick="atualizarPagamentos('total')">
                                Total
                            </button>
                        </div>

                    </div>

                    <!-- GRÁFICO -->
                    <div class="d-flex justify-content-center align-items-center flex-fill">
                        <canvas id="graficoPagamentos"
                                style="max-width:280px; max-height:280px;"></canvas>
                    </div>

                </div>

            </div>

        </div>

        <!-- BOTTOM -->
        <div class="row g-3 mb-3">

            <!-- Estoque -->
            <div class="col-6 col-md-3">
                <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-box-seam" style="color:#f59e0b;"></i>
                        <span class="text-light">Estoque</span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1" style="font-size:.75rem;">
                            <span class="text-light">Estoque Baixo</span>
                            <span style="color:#f59e0b;">@Model.EstoqueBaixo produtos</span>
                        </div>
                        <div class="rounded-pill" style="height:10px; background:#1a1e28;">
                            <div class="rounded-pill" style="height:10px; width:@(Math.Min(Model.EstoqueBaixo * 10, 100))%; background:#f59e0b;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between mb-1" style="font-size:.75rem;">
                            <span class="text-light">Sem Estoque</span>
                            <span style="color:#f87171;">@Model.SemEstoque produtos</span>
                        </div>
                        <div class="rounded-pill" style="height:10px; background:#1a1e28;">
                            <div class="rounded-pill" style="height:10px; width:@(Math.Min(Model.SemEstoque * 10, 100))%; background:#f87171;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Destaques -->
            <div class="col-6 col-md-3">
                <div class="card border rounded-3 h-100 p-3"
                     style="background:#13161d;">

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-bag-check" style="color:#34d399; font-size:14px;"></i>
                        <span class="text-light">
                            Destaques
                        </span>
                    </div>

                    <!-- MAIS VENDIDO -->
                    <div class="d-flex align-items-center gap-2 rounded-3 mb-2 p-2"
                         style="background:#1a1e28;">

                        <span class="text-light flex-fill text-truncate">
                            @(Model.ProdutoMaisVendido ?? "—")
                        </span>

                        <span style="color:#34d399">
                            <i class="bi bi-plus-lg" style="color:#34d399; font-size:14px;"></i> Vendido
                        </span>
                    </div>

                    <!-- MAIS LUCRATIVO -->
                    <div class="d-flex align-items-center gap-2 rounded-3 p-2"
                         style="background:#1a1e28;">


                        <span class="text-light flex-fill">
                            @(Model.ProdutoMaisLucrativo ?? "—")
                        </span>

                        <span style="color:#f87171">
                            <i class="bi bi-plus-lg" style="color:#f87171; font-size:14px;"></i> Lucrativo
                        </span>
                    </div>

                </div>
            </div>

            <!-- Top 3 -->
            <div class="col-6 col-md-3">
                <div class="card border rounded-3 h-100 p-3" style="background:#13161d;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-fire" style="color:#f87171;"></i>
                        <span class="text-light">Top 3 em Alta</span>
                    </div>

                    @if (Model.Top3ProdutosAlta != null && Model.Top3ProdutosAlta.Any())
                    {
                        string[] cores = { "#f59e0b", "#9ca3af", "#cd7f32" };
                        for (int i = 0; i < Model.Top3ProdutosAlta.Count && i < 3; i++)
                        {
                            <div class="d-flex align-items-center gap-2 rounded-3 mb-2 p-2"
                                 style="background:#1a1e28; border:1px solid rgba(255,255,255,0.07);">
                                <span style="font-size:.7rem; width:20px; color:@cores[i]; flex-shrink:0;">#@(i + 1)</span>
                                <span class="text-light flex-fill text-truncate" style="font-size:.8rem;">@Model.Top3ProdutosAlta[i]</span>
                                <i class="bi bi-arrow-up-short" style="color:#34d399; font-size:14px;"></i>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-secondary">Dados insuficientes</small>
                    }
                </div>
            </div>

            <!-- Previsão -->
            <div class="col-6 col-md-3">
                <div class="card border rounded-3 h-100 p-3 d-flex flex-column"
                     style="background:#13161d;">

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-graph-up-arrow" style="color:#a78bfa;"></i>
                        <span class="text-light">Previsão Amanhã</span>
                    </div>

                    <div class="border rounded-3 flex-fill d-flex justify-content-center align-items-center p-3"
                         style="background:#13161d;">

                        <div class="fw-semibold text-center"
                             style="font-size:2rem; color:#34d399; line-height:1;">
                            R$ @Model.PrevisaoAmanha.ToString("N2")
                            <div class="text-secondary mt-2" style="font-size:.7rem;">
                                estimativa aproximada
                            </div>
                        </div>
                        
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>
<script>
    window.dashData = {
        pagamentos: {
            hoje: @Html.Raw(Json.Serialize(new[] { Model.PixHoje, Model.CartaoHoje, Model.DinheiroHoje })),
            semana: @Html.Raw(Json.Serialize(new[] { Model.PixSemana, Model.CartaoSemana, Model.DinheiroSemana })),
            mes: @Html.Raw(Json.Serialize(new[] { Model.PixMes, Model.CartaoMes, Model.DinheiroMes })),
            total: @Html.Raw(Json.Serialize(new[] { Model.PixTotal, Model.CartaoTotal, Model.DinheiroTotal }))
        },

        vendas: {
            hoje: @Html.Raw(Json.Serialize(Model.VendasHojeLista)),
            semana: @Html.Raw(Json.Serialize(Model.VendasSemana)),
            mes: @Html.Raw(Json.Serialize(Model.VendasMesGrafico)),
            ano: @Html.Raw(Json.Serialize(Model.VendasAno))
        }
    };
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/dash.js"></script>



