@model FornecedorModel
@{
    ViewData["Title"] = "Editar Fornecedor";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-3 text-center">
        <h1 class="text-light">Editar Fornecedor</h1>
    </div>

    <form method="post" asp-action="Editar">

        <input type="hidden" asp-for="FornecedorID" />

        <!-- NOME -->
        <div class="mb-4">
            <label class="form-label text-light">Nome</label>
            <input type="text" class="form-control bg-white text-dark" asp-for="FornecedorNome">
            <span asp-validation-for="FornecedorNome" class="text-danger"></span>
        </div>

        <!-- CNPJ -->
        <div class="mb-4">
            <label class="form-label text-light">CNPJ</label>
            <input type="text"
                   id="FornecedorCNPJ"
                   class="form-control bg-white text-dark"
                   asp-for="FornecedorCNPJ"
                   maxlength="18">
            <span asp-validation-for="FornecedorCNPJ" class="text-danger"></span>
        </div>

        <!-- TELEFONE E EMAIL -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label text-light">Telefone</label>
                <input type="text"
                       id="FornecedorTelefone"
                       class="form-control bg-white text-dark"
                       asp-for="FornecedorTelefone"
                       maxlength="15">
                <span asp-validation-for="FornecedorTelefone" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label text-light">E-mail</label>
                <input type="email" class="form-control bg-white text-dark" asp-for="FornecedorEmail">
                <span asp-validation-for="FornecedorEmail" class="text-danger"></span>
            </div>
        </div>

        <!-- CEP + BOTÃO + ESTADO + CIDADE -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-light">CEP</label>
                <div class="input-group">
                    <input type="text"
                           id="FornecedorCEP"
                           class="form-control bg-white text-dark"
                           asp-for="FornecedorCEP"
                           maxlength="9">

                    <button type="button" id="btnBuscarCEP" class="btn btn-primary">
                        Buscar
                    </button>
                </div>
                <span asp-validation-for="FornecedorCEP" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label class="form-label text-light">Estado</label>
                <input type="text" id="FornecedorEstado" class="form-control bg-white text-dark" readonly asp-for="FornecedorEstado">
            </div>

            <div class="col-md-6">
                <label class="form-label text-light">Cidade</label>
                <input type="text" id="FornecedorCidade" class="form-control bg-white text-dark" readonly asp-for="FornecedorCidade">
            </div>
        </div>

        <!-- LOGRADOURO + BAIRRO + NUMERO -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label text-light">Logradouro</label>
                <input type="text" id="FornecedorLogradouro" class="form-control bg-white text-dark" asp-for="FornecedorLogradouro" readonly>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Bairro</label>
                <input type="text" id="FornecedorBairro" class="form-control bg-white text-dark" readonly asp-for="FornecedorBairro">
            </div>

            <div class="col-md-2">
                <label class="form-label text-light">Número</label>
                <input type="text" class="form-control bg-white text-dark" asp-for="FornecedorNum">
                <span asp-validation-for="FornecedorNum" class="text-danger"></span>
            </div>
        </div>

        <!-- BOTÕES -->
        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-success w-50">Salvar</button>
            <a class="btn btn-primary w-50" asp-action="Index">Voltar</a>
        </div>

    </form>
</div>

@section Scripts{
<script>
    $("#btnBuscarCEP").click(function(){
        var cep = $("#FornecedorCEP").val().replace(/\D/g, '');

        if(cep.length !== 8){
            alert("CEP inválido!");
            return;
        }

        $.getJSON(`https://viacep.com.br/ws/${cep}/json/`, function(dados){
            if(!("erro" in dados)){
                $("#FornecedorLogradouro").val(dados.logradouro);
                $("#FornecedorBairro").val(dados.bairro);
                $("#FornecedorCidade").val(dados.localidade);
                $("#FornecedorEstado").val(dados.uf);
            } else {
                alert("CEP não encontrado.");
            }
        });
    });
</script>
}