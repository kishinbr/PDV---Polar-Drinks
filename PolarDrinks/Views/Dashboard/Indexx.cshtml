@{
    ViewData["Title"] = "Dashboard";
}
@model PolarDrinks.Models.DashboardViewModel
@using System.Globalization
<div class="container-fluid mt-2">

    <h3 class="fw-bold mb-4">Dashboard</h3>

    <div class="row g-3 mb-4 ">

        <!-- COLUNA ESQUERDA -->
        <div class="col-md-8 d-flex flex-column gap-3">

            <!-- FINANCEIRO (2x2) -->
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="card bg-dark-subtle text-dark p-3 shadow rounded-4">
                        <small>Total Hoje</small>
                        <h4> @("R" + Model.TotalHoje.ToString("C"))</h4>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card bg-dark-subtle text-dark p-3 shadow rounded-4">
                        <small>Total Mês</small>
                        <h4> @("R" + Model.TotalMes.ToString("C"))</h4>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card bg-dark-subtle  p-3 shadow rounded-4">
                        <small>Lucro Hoje</small>
                        <h4> @("R" + Model.LucroHoje.ToString("C"))</h4>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card bg-dark-subtle p-3 shadow rounded-4">
                        <small>Lucro Mês</small>
                        <h4> @("R" + Model.LucroMes.ToString("C"))</h4>
                    </div>
                </div>

            </div>

            <!-- GRÁFICO VENDAS -->
            <div class="card shadow border-0 rounded-4 p-3 flex-fill">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h6 class="mb-0">Vendas</h6>

                    <span class="badge bg-light text-dark border" id="totalVendasLabel">
                        Qtd vendas: 0
                    </span>

                    <div class="btn-group btn-group-sm flex-wrap">
                        <button class="btn btn-outline-primary" onclick="atualizarVendas('hoje')">Hoje</button>
                        <button class="btn btn-outline-primary" onclick="atualizarVendas('semana')">7d</button>
                        <button class="btn btn-outline-primary" onclick="atualizarVendas('mes')">30d</button>
                        <button class="btn btn-outline-primary" onclick="atualizarVendas('ano')">Ano</button>
                    </div>
                </div>

                <canvas id="graficoVendas" style="height:300px;"></canvas>

            </div>

        </div>

        <!-- COLUNA DIREITA -->
        <div class="col-md-4 d-flex flex-column gap-3">

            <!-- PAGAMENTOS (CARDS) -->
            <div class="row g-3">

                <div class="col-12 col-xl-4">
                    <div class="card bg-success text-white p-3 shadow rounded-4 h-100">
                        <small><img src="/img/pix.png" width="16" class="me-1">Pix</small>
                        <div>@Model.QtdPix vendas</div>
                        <h5> @("R" + Model.TotalPix.ToString("C"))</h5>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card bg-primary text-white p-3 shadow rounded-4 h-100">
                        <small>💳 Cartão</small>
                        <div>@Model.QtdCartao vendas</div>
                        <h5>
                            @("R" + Model.PrevisaoAmanha.ToString("C"))
                        </h5>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card bg-warning text-white p-3 shadow rounded-4 h-100">
                        <small>💵 Dinheiro</small>
                        <div>@Model.QtdDinheiro vendas</div>
                        <h5> @("R" + Model.TotalDinheiro.ToString("C"))</h5>
                    </div>
                </div>

            </div>

            <!-- GRÁFICO PAGAMENTOS -->
            <div class="card shadow border-0 rounded-4 p-3 flex-fill">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">

                    <h6 class="mb-0">Formas de Pagamento</h6>

                    <span class="badge bg-success" id="qtdPagamentosLabel">
                        Qtd vendas: 0
                    </span>

                    <div class="btn-group btn-group-sm flex-wrap">
                        <button class="btn btn-outline-success" onclick="atualizarPagamentos('hoje')">Hoje</button>
                        <button class="btn btn-outline-success" onclick="atualizarPagamentos('semana')">7d</button>
                        <button class="btn btn-outline-success" onclick="atualizarPagamentos('mes')">30d</button>
                        <button class="btn btn-outline-success" onclick="atualizarPagamentos('total')">Total</button>
                    </div>

                </div>

                <div class="d-flex justify-content-center align-items-center flex-fill">
                    <canvas id="graficoPagamentos" style="max-width:280px; max-height:280px;"></canvas>
                </div>

            </div>

        </div>

    </div>

    <!-- LINHA INFERIOR -->
    <div class="row g-3 mb-4">

        <!-- ESTOQUE -->
        <div class="col-md-3">
            <div class="card shadow rounded-4 h-100 p-3">
                <h6 class="mb-3">Estoque</h6>

                <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded bg-warning">
                    <div>
                        <small>Estoque Baixo</small>
                        <h5 class="mb-0">@Model.EstoqueBaixo</h5>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-danger text-white">
                    <div>
                        <small>Sem Estoque</small>
                        <h5 class="mb-0">@Model.SemEstoque</h5>
                    </div>
                </div>

            </div>
        </div>

        <!-- PRODUTOS -->
        <div class="col-md-3">
            <div class="card shadow rounded-4 h-100 p-3">
                <h6 class="mb-3">Produtos</h6>

                <div class="mb-3 p-2 rounded bg-success-subtle text-dark">
                    <small>Mais Vendido</small>
                    <h5 class="mb-0">@Model.ProdutoMaisVendido</h5>
                </div>

                <div class="p-2 rounded bg-success-subtle text-dark">
                    <small>Mais Lucrativo</small>
                    <h5 class="mb-0">@Model.ProdutoMaisLucrativo</h5>
                </div>

            </div>
        </div>

        <!-- TOP 3 PRODUTOS EM ALTA (NOVO) -->
        <div class="col-md-3">
            <div class="card shadow rounded-4 h-100 p-3">
                <h6 class="mb-3">Em Alta </h6>

                @if (Model.Top3ProdutosAlta.Any())
                {
                    <!-- TOP 1 OURO -->
                    <div class="mb-2 p-2 rounded text-dark text-center bg-warning-subtle">
                        <small>#1</small>
                        <h6 class="mb-0">@Model.Top3ProdutosAlta[0]</h6>
                    </div>

                    <!-- TOP 2 PRATA + TOP 3 BRONZE -->
                    <div class="d-flex gap-2">

                        @if (Model.Top3ProdutosAlta.Count > 1)
                        {
                            <div class="flex-fill p-2 rounded text-dark text-center bg-light">
                                <small>#2</small>
                                <h6 class="mb-0">@Model.Top3ProdutosAlta[1]</h6>
                            </div>
                        }

                        @if (Model.Top3ProdutosAlta.Count > 2)
                        {
                            <div class="flex-fill p-2 rounded text-dark text-center"
                                 style="background: linear-gradient(135deg, #CD7F32, #B87333);">
                                <small>#3</small>
                                <h6 class="mb-0">@Model.Top3ProdutosAlta[2]</h6>
                            </div>
                        }

                    </div>
                }
                else
                {
                    <small class="text-muted">Sem dados suficientes</small>
                }

            </div>
        </div>

        <!-- ANÁLISE -->
        <div class="col-md-3">
            <div class="card shadow rounded-4 h-100 p-3 d-flex flex-column justify-content-center">

                <h6 class="mb-3">Análise</h6>

                <div class="flex-fill d-flex flex-column justify-content-center align-items-center text-center bg-dark-subtle">

                    <small class="text-muted">Previsão de vendas amanhã</small>

                    <h3 class="mt-2 fw-bold">
                        @("R" + Model.PrevisaoAmanha.ToString("C"))
                    </h3>

                </div>

            </div>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    //lista de pagamentos para cada período, já no formato [pix, cartao, dinheiro]
    const pagamentos = {
    hoje: [@Model.PixHoje, @Model.CartaoHoje, @Model.DinheiroHoje],
    semana: [@Model.PixSemana, @Model.CartaoSemana, @Model.DinheiroSemana],
    mes: [@Model.PixMes, @Model.CartaoMes, @Model.DinheiroMes],
    total: [@Model.PixTotal, @Model.CartaoTotal, @Model.DinheiroTotal]
    };


    const vendas = {
    hoje: @Html.Raw(Json.Serialize(Model.VendasHojeLista)),
    semana: @Html.Raw(Json.Serialize(Model.VendasSemana)),
    mes: @Html.Raw(Json.Serialize(Model.VendasMesGrafico)),
    ano: @Html.Raw(Json.Serialize(Model.VendasAno))
    };

    //grafico de pizza para formas de pagamento
    let graficoPagamentos = new Chart(document.getElementById('graficoPagamentos'), {
    type: 'pie',
    data: {
    labels: ['Pix', 'Cartão', 'Dinheiro'],
    datasets: [{
    data: pagamentos.hoje,
    backgroundColor: [
    '#198754', // Pix 
    '#0D6EFD', // Cartão
    '#FFC107'  // Dinheiro
    ],
    }]
    }
    });

    function atualizarPagamentos(tipo) {

    const dados = pagamentos[tipo];

    // atualiza gráfico
    graficoPagamentos.data.datasets[0].data = dados;
    graficoPagamentos.update();


    const totalQtd = dados.reduce((acc, val) => acc + val, 0);

    // atualiza label
    document.getElementById("qtdPagamentosLabel").innerText =
    `Total de vendas: ${totalQtd}`;
    }

    //grafico de barras para vendas ao longo do tempo
    let graficoVendas = new Chart(document.getElementById('graficoVendas'), {
    type: 'bar',
    data: {
    labels: [],
    datasets: [{
    label: 'Vendas',
    data: [],
    tension: 0.4 
    }]
    }
    });

    function atualizarVendas(tipo) {

    let labels = [];


    if (tipo === "hoje") {
    labels = vendas.hoje.map((_, i) => `${i}h`);
    }

    else if (tipo === "semana") {

    const diasSemana = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];
    const hoje = new Date();

    labels = vendas.semana.map((_, i) => {
    let data = new Date();
    data.setDate(hoje.getDate() - (vendas.semana.length - 1 - i));
    return diasSemana[data.getDay()];
    });
    }

    else if (tipo === "mes") {
    labels = vendas.mes.map((_, i) => `${i + 1}`);
    }

    else if (tipo === "ano") {

    const meses = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun",
    "Jul", "Ago", "Set", "Out", "Nov", "Dez"];

    const hoje = new Date();

    labels = vendas.ano.map((_, i) => {
    let data = new Date();
    data.setMonth(hoje.getMonth() - (vendas.ano.length - 1 - i));

    let mes = meses[data.getMonth()];
    let ano = data.getFullYear();

    return `${mes}/${ano}`;
    });
    }
    
    // atualiza gráfico
    graficoVendas.data.labels = labels;
    graficoVendas.data.datasets[0].data = vendas[tipo];
    graficoVendas.update();
    const total = vendas[tipo].reduce((acc, val) => acc + val, 0);

    document.getElementById("totalVendasLabel").innerText =
    `Qtd vendas: ${total}`;

    }

    // inicializa os gráficos com os dados de hoje
    atualizarVendas("semana");
    atualizarPagamentos("hoje");


</script>