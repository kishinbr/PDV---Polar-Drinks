@model PolarDrinks.ViewModels.CompraCreateViewModel
@{
    ViewData["Title"] = "Novo Reabastecimento";
}

<div class="container bg-dark p-5 mt-5 rounded-5">

    <div class="text-center mb-4">
        <h2 class="text-light">Novo Reabastecimento</h2>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert bg-success text-light">@TempData["MensagemSucesso"]</div>
    }
    else if (TempData["MensagemErro"] != null)
    {
        <div class="alert bg-danger text-light">@TempData["MensagemErro"]</div>
    }

    <div id="erroTabela" class="alert bg-danger text-light d-none">
        Adicione pelo menos um produto antes de salvar.
    </div>

    <form method="post" id="formCompra">
        <div class="mb-4">
            <label class="form-label text-light">Fornecedor</label>
            <select class="form-select bg-light text-dark" asp-for="FornecedorID" asp-items="Model.Fornecedores">
                <option value="">Selecione um fornecedor</option>
            </select>
            <span asp-validation-for="FornecedorID" class="text-danger"></span>
        </div>

        <table class="table table-light" id="tabelaItens">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th style="width:150px;">Quantidade</th>
                    <th style="width:150px;">Preço</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Itens.Count; i++)
                {
                    <tr>
                        <td>
                            <select class="form-select" asp-for="Itens[@i].ProdutoID" asp-items="Model.Produtos">
                                <option value="">Selecione</option>
                            </select>
                            <span asp-validation-for="Itens[@i].ProdutoID" class="text-danger"></span>
                        </td>
                        <td>
                            <input class="form-control" asp-for="Itens[@i].Quantidade" type="text" />
                            <span asp-validation-for="Itens[@i].Quantidade" class="text-danger"></span>
                        </td>
                        <td>
                            <input class="form-control preco-input" asp-for="Itens[@i].Preco" type="text"/>
                            <span asp-validation-for="Itens[@i].Preco" class="text-danger"></span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-remover">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mb-3">
            <button type="button" id="addItem" class="btn btn-primary">
                + Adicionar Produto
            </button>
            <span class="fw-bold text-light" id="totalPreco">Total: R$ 0.00</span>
        </div>

        <div class="d-flex gap-3">
            <a asp-action="Index" class="btn btn-primary w-50">Voltar</a>
            <button type="submit" class="btn btn-success w-50" id="btnSalvar" disabled>Salvar</button>
            
        </div>
    </form>
</div>
@if (Model.ProdutosEstoque != null && Model.ProdutosEstoque.Any())
{
    <div class="d-flex justify-content-between container align-items-center  bg-dark text-light p-4 mt-4 rounded-4">
        <h4 class="m-0">Produtos em Estoque</h4>
    </div>

    <div class="container rounded-4">
        <table id="tabelaEstoqueConsulta" class="table table-success table-hover mb-0">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Preço de Custo</th>
                    <th>Preço de Venda</th>
                    <th>Estoque/Min</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.ProdutosEstoque)
                {
                    <tr>
                        <td>@p.ProdutoNome</td>
                        <td >R$ @p.ProdutoPrecoCusto.GetValueOrDefault(0).ToString("N2")</td>
                        <td >R$ @p.ProdutoPrecoVenda.GetValueOrDefault(0).ToString("N2")</td>
                        <td >
                            @if (p.ProdutoQtdEstoque <= p.ProdutoEstoqueMinimo)
                            {
                                <span class="badge bg-warning text-dark">@p.ProdutoQtdEstoque/@p.ProdutoEstoqueMinimo</span>
                            }
                            else
                            {
                                <span>@p.ProdutoQtdEstoque/@p.ProdutoEstoqueMinimo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        const options = `@Html.Raw(string.Join("", Model.Produtos.Select(p => $"<option value='{p.Value}'>{p.Text}</option>")))`;

        function proximoIndice() {
            return $("#tabelaItens tbody tr").length;
        }

        function renumerarIndices() {
            $("#tabelaItens tbody tr").each(function (i) {
                $(this).find("select").attr("name", `Itens[${i}].ProdutoID`);
                $(this).find("input[name$='.Quantidade']").attr("name", `Itens[${i}].Quantidade`);
                $(this).find("input[name$='.Preco']").attr("name", `Itens[${i}].Preco`);
            });
        }

        function atualizarBotaoSalvar() {
            $("#btnSalvar").prop("disabled", $("#tabelaItens tbody tr").length === 0);
        }

        function atualizarTotal() {
            let total = 0;

            $("#tabelaItens tbody tr").each(function () {
                let qtd = parseFloat($(this).find('input[name$=".Quantidade"]').val());
                let preco = parseFloat($(this).find('input[name$=".Preco"]').val());

                if (!isNaN(qtd) && !isNaN(preco)) {
                    total += qtd * preco;
                }
            });

            $("#totalPreco").text("Total: R$ " + total.toFixed(2));
        }

        $("#addItem").click(function () {

            let index = proximoIndice();

            let newRow = $(`
                <tr>
                    <td>
                        <select name="Itens[${index}].ProdutoID" class="form-select">
                            <option value="">Selecione</option>
                            ${options}
                        </select>
                    </td>
                    <td>
                        <input type="text" name="Itens[${index}].Quantidade" class="form-control" value="0" />
                    </td>
                    <td>
                        <input type="text" name="Itens[${index}].Preco" class="form-control preco-input" value="0.00" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-remover">X</button>
                    </td>
                </tr>
            `);

            $("#tabelaItens tbody").append(newRow);

            renumerarIndices();
            atualizarTotal();
            atualizarBotaoSalvar();
        });

        $(document).on("click", ".btn-remover", function () {
            $(this).closest("tr").remove();
            renumerarIndices();
            atualizarTotal();
            atualizarBotaoSalvar();
        });

        $(document).on("input", 'input[name$=".Quantidade"]', function () {
            let value = this.value;

            value = value.replace(/[^0-9]/g, '');

            if (value.length > 1) {
                value = value.replace(/^0+/, '');
            }

            if (value.length > 4) {
                value = value.substring(0, 4);
            }

            if (value !== '') {
                let numero = parseInt(value);

                if (numero > 9999) {
                    value = '9999';
                }
            }

            this.value = value;
            atualizarTotal();
        });

                $(document).on("input", 'input.preco-input', function () {
            let value = this.value;

            value = value.replace(/[^0-9.]/g, '');

            let parts = value.split('.');
            if (parts.length > 2) {
                value = parts[0] + '.' + parts[1];
            }

            let [intPart, decPart] = value.split('.');

            if (intPart && intPart.length > 1) {
                intPart = intPart.replace(/^0+/, '');
            }

            if (intPart) {
                intPart = intPart.substring(0, 5);
            }

            if (decPart !== undefined) {
                decPart = decPart.substring(0, 2);
                value = intPart + '.' + decPart;
            } else {
                value = intPart;
            }

            if (value !== '' && !isNaN(value)) {
                let numero = parseFloat(value);
                if (numero > 99999.99) {
                    value = '99999.99';
                }
            }

            this.value = value;
            atualizarTotal();
        });

        $("#formCompra").on("submit", function (e) {
            let temItens = $("#tabelaItens tbody tr").length > 0;

            if (!temItens) {
                e.preventDefault();
                $("#erroTabela").removeClass("d-none").hide().fadeIn();
                window.scrollTo(0, 0);
                return false;
            }

            $("#erroTabela").addClass("d-none");
            renumerarIndices();

            $('input.preco-input').each(function () {
                if (this.value.trim() === '' || isNaN(this.value)) {
                this.value = '0.00';
            }
            });

            $('input[name$=".Quantidade"]').each(function () {
                if (this.value.trim() === '' || isNaN(this.value)) {
                    this.value = '0';
                }
            });
        });

        $(document).ready(function () {
            atualizarTotal();
            atualizarBotaoSalvar();
        });

            $('#tabelaEstoqueConsulta').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 15],
            scrollX: true,
            scrollCollapse: true,
            paging: true,

            columnDefs: [
                { className: "text-center", targets: [1,2,3] }
            ],
            language: {
                "emptyTable":    "Nenhum produto encontrado",
                "info":          "Mostrando _START_ a _END_ de _TOTAL_ produtos",
                "infoEmpty":     "Mostrando 0 produtos",
                "infoFiltered":  "(filtrado de _MAX_)",
                "lengthMenu":    "Mostrar _MENU_ produtos",
                "search":        "Procurar:",
                "zeroRecords":   "Produto não encontrado",
                "paginate": {
                    "first":    "Primeiro",
                    "last":     "Último",
                    "next":     "Próximo",
                    "previous": "Anterior"
                }
            }
        });
    </script>
}