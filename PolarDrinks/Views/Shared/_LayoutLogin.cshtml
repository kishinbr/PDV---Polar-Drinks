<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="icon" href="~/img/icon.png" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/layout.css" />
</head>
<body style="background:#495057;" class="text-light">
    <div class="topbar">
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral">
            <i class="bi bi-list"></i>
        </button>
        <div> <img src="/img/polaria.png" width="32" height="32">Polar Drinks</div>
    </div>

    <div class="sidebar">
        <div class="brand"><img src="/img/polaria.png" width="32" height="32"> Polar Drinks</div>


        <a>
            <i class="bi bi-box-arrow-right"></i> Deslogar
        </a>
    </div>

    <!-- menu hamburguer -->
    <div class="offcanvas offcanvas-start text-light"
         tabindex="-1"
         id="menuLateral"
         style="background:#181818;">

        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title"><img src="/img/polaria.png" width="32" height="32"> Polar Drinks</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body p-3">


            <div class="menu-section">SAIR</div>

            <a class="menu-item" href="#">
                <i class="bi bi-box-arrow-right"></i> Deslogar
            </a>

        </div>
    </div>

    <!-- onde as views sao renderizadas -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>